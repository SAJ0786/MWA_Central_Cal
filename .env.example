# ── Copy this to .env and fill in your values ─────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web app → SDK snippet
# Do NOT commit the real .env file. Secrets stay out of source control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Organisation timezone used for all display/formatting (IANA name)
VITE_ORG_TIMEZONE=Australia/Sydney

# Region the Cloud Functions are deployed to (must match functions/index.js)
VITE_FUNCTIONS_REGION=australia-southeast1
